TRAILLOG_ENVIRONMENT=prod
TRAILLOG_HTTP_ADDRESS=:8080
TRAILLOG_LOG_LEVEL=info
TRAILLOG_LOG_FORMAT=json
TRAILLOG_DATABASE_PATH=/data/traillog.db
TRAILLOG_DATABASE_BUSY_TIMEOUT=5s
TRAILLOG_DATABASE_CONNECT_TIMEOUT=5s
TRAILLOG_DATABASE_MAX_OPEN_CONNECTIONS=5
TRAILLOG_DATABASE_MAX_IDLE_CONNECTIONS=5
TRAILLOG_GPX_MAX_UPLOAD_BYTES=20971520
TRAILLOG_GPX_MAX_TRACK_POINTS=200000
TRAILLOG_GPX_MAX_TEXT_FIELD_BYTES=65536
TRAILLOG_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
TRAILLOG_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
OTEL_TRACES_EXPORTER=none
OTEL_METRICS_EXPORTER=none

